# AlphaGuard V2 frontend env (Vite). Copy to .env.local and fill in.

# Realtime backend base URL
VITE_AG_API=http://localhost:4000

# --- WebRTC TURN (Phase 8A) ---------------------------------------------
# STUN is always on (Google public STUN) — these add a TURN relay fallback so
# monitoring works across different networks / symmetric NAT / mobile data.
# Leave blank to keep STUN-only behaviour.
#
# Comma-separated TURN URLs. Prefer turns: (TLS, port 5349) plus turn: as fallback.
# VITE_TURN_URLS=turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349
# VITE_TURN_USERNAME=alphaguard
# VITE_TURN_CREDENTIAL=replace-with-strong-secret
#
# Set to 1 to force relay-only (iceTransportPolicy:'relay') — use to verify TURN
# actually works; leave unset in production so direct/STUN paths are preferred.
# VITE_TURN_FORCE_RELAY=0
