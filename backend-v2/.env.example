# AlphaGuard V2 backend env. Copy to .env for local dev (never commit the real .env).
# In production these are set in the Render dashboard (see render.yaml).

# --- PostgreSQL ----------------------------------------------------------
# When set, the backend uses PostgreSQL (hydrates cache + write-through).
# When UNSET, it falls back to a local JSON file (data/alphaguard.json) — dev only.
# DATABASE_URL=postgres://user:password@host:5432/alphaguard
# Set to 1 when the Postgres provider requires SSL (Render, Heroku, Supabase do).
# PGSSL=1

# --- JWT (auth — REST + Socket.IO handshake) -----------------------------
# Secret used to sign/verify parent & child tokens. MUST be a long random string
# in production. On Render this is generated via render.yaml (generateValue).
# AG_JWT_SECRET=replace-with-a-long-random-secret

# --- Server --------------------------------------------------------------
# PORT is provided by the host (Render injects it). Defaults to 4000 locally.
# PORT=4000

# --- JSON fallback (dev only) -------------------------------------------
# Override the local JSON DB path used when DATABASE_URL is not set.
# AG_DB_FILE=./data/alphaguard.json

# --- Socket.IO / CORS ----------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call the REST API
# and open Socket.IO connections. AG_CORS_ORIGINS takes precedence; FRONTEND_URL
# is accepted as a single-origin shorthand. When BOTH are unset the server
# reflects any origin in development but DENIES all browser origins in production
# (NODE_ENV=production) — so set this before going live.
# AG_CORS_ORIGINS=https://app.alphaguard.ai,https://www.alphaguard.ai
# FRONTEND_URL=https://your-frontend.vercel.app

# --- Demo endpoint -------------------------------------------------------
# /api/dev/demo-pairing mints parent+child tokens with NO authentication and is
# for local development only. It is automatically disabled when NODE_ENV=production.
# Set AG_ENABLE_DEMO=1 to force-enable it on a throwaway box. Never in production.
# AG_ENABLE_DEMO=1

# --- Push notifications (FCM, Phase 4A) ----------------------------------
# Required to actually DELIVER push (SOS/chat/alerts to a backgrounded device).
# Without them, registration still works and in-app/realtime notifications are
# unaffected — sendToUser is simply a no-op. APNs (iOS) is delivered via FCM.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}  # the JSON, as one line

# --- Password reset email (Phase 4E) -------------------------------------
# The secure token flow works without this (the reset link is logged in dev).
# Set SMTP_URL (and optionally nodemailer must be installed) to actually email it.
# SMTP_URL=smtps://user:pass@smtp.provider.com:465
# SMTP_FROM=AlphaGuard <no-reply@alphaguard.ai>

# --- TURN ----------------------------------------------------------------
# TURN credentials are consumed by the FRONTEND at build time (VITE_TURN_* in
# frontend-v2/.env), NOT by this backend. The backend only relays SDP/ICE over
# Socket.IO and never touches media. No TURN env is needed here.
